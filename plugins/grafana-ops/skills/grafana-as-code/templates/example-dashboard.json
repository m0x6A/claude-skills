{
  "uid": "acme-service-overview",
  "title": "Acme Shop / Service overview",
  "description": "Rate, errors and duration (RED) per service. Every query carries service_namespace=\"acme\"; the stack is shared, and grouping by service_name does not filter.",
  "tags": ["acme"],
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "version": 1,
  "annotations": { "list": [] },
  "links": [
    {
      "title": "Acme Shop dashboards",
      "type": "dashboards",
      "tags": ["acme"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "description": "Services of this app that served HTTP in the selected range. All means every acme-* service, never every service on the stack.",
        "datasource": "grafanacloud-acme-prom",
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service_namespace=\"acme\"}, service_name)",
          "refId": "service"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_namespace=\"acme\"}, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "acme-.*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests, 5xx and p95 latency",
      "description": "RED for the selected services, from http_server_request_duration_seconds (the HTTP server histogram). Left axis: requests and 5xx responses per second. Right axis: p95 duration. Threshold line at 2 s, the latency alert's threshold.",
      "datasource": "grafanacloud-acme-prom",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95 duration" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.thresholdsStyle", "value": { "mode": "line" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 2 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=\"acme\", service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "requests"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=\"acme\", service_name=~\"$service\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_namespace=\"acme\", service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95 duration"
        }
      ]
    }
  ]
}
